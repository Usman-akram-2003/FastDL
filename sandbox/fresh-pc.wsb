<!-- Fresh-PC test: Windows Sandbox is a clean, throwaway Windows. Double-click this file (after build.py).
     Needs the "Windows Sandbox" feature (Windows Pro/Enterprise). Report: sandbox-results\report.txt -->
<Configuration>
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder><HostFolder>C:\project\fastdl\dist</HostFolder><SandboxFolder>C:\fastdl-dist</SandboxFolder><ReadOnly>true</ReadOnly></MappedFolder>
    <MappedFolder><HostFolder>C:\project\fastdl\sandbox</HostFolder><SandboxFolder>C:\fastdl-test</SandboxFolder><ReadOnly>true</ReadOnly></MappedFolder>
    <MappedFolder><HostFolder>C:\project\fastdl\sandbox-results</HostFolder><SandboxFolder>C:\fastdl-results</SandboxFolder><ReadOnly>false</ReadOnly></MappedFolder>
  </MappedFolders>
  <LogonCommand><Command>powershell -NoProfile -ExecutionPolicy Bypass -File C:\fastdl-test\fresh-pc.ps1</Command></LogonCommand>
</Configuration>
