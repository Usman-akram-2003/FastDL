<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": paste it into SignPath (Project > Artifact configurations).
     GitHub's upload-artifact wraps the file in a ZIP, which is why the root is zip-file. Only the installer is signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="FastDL-Setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
